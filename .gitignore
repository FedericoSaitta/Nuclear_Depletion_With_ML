# Build artifacts
/build/
__pycache__/
*.pyc
*.egg-info
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Editors
.vscode
.vs

# Cluster job scripts + logs (generated by scripts/gpu_job_runner.py)
submit_gpu_job.sh
run_datagen.sh
logs/
*.out
*.err
*.log

# Figures and generated HTML
*.png
*.html

# Simulation output. Scoped, not blanket: data_generation/*.csv holds the
# measured power histories, which are inputs worth tracking, and a blanket rule
# is what made them un-committable before.
data_generation/data/
data_generation/results/
/data/
/datasets/
/results/
/predictions/
# Model bundles are run output: a training run writes its own. Publish a
# specific bundle deliberately (Zenodo, a release) rather than tracking the
# whole directory.
/bundles/
*.h5
*.hdf5

# OpenMC exports and per-run XML. Depletion chains live in the untracked
# data/ download; util/reduce_decay_chains.py regenerates any trimmed variant.
*.xml

# Test fixtures are deliberately tracked — they are the golden safety net
!tests/fixtures/**

# Documentation images are tracked
!README_images/**

# uv environments
/.venv/
/.venv-sim/

# OpenMC source + build tree (rebuilt by scripts/install_openmc.sh)
/external/
