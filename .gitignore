# Build artifacts
/build/
__pycache__/
*.pyc
*.egg-info
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Editors
.vscode
.vs

# Cluster job scripts + logs (generated by scripts/gpu_job_runner.py)
submit_gpu_job.sh
run_datagen.sh
logs/
*.out
*.err
*.log

# Figures, experiment databases, generated HTML
*.png
*.db
*.html

# Simulation output. Scoped, not blanket: data_generation/*.csv (power
# histories) and util/util_results/*.xml (trimmed chains) are inputs worth
# tracking, and a blanket rule is what made them un-committable before.
data_generation/data/
data_generation/results/
util/results/
/data/
/datasets/
/results/
# Model bundles are build output: `nucml-package` regenerates one from a
# checkpoint + its config. Publish a specific bundle deliberately (Zenodo,
# a release) rather than tracking the whole directory.
/bundles/
*.h5
*.hdf5

# OpenMC exports and per-run XML (the tracked chains under
# util/util_results/ are re-added explicitly below)
*.xml
!util/util_results/**/*.xml

# Test fixtures are deliberately tracked — they are the golden safety net
!tests/fixtures/**

# uv environments
/.venv/
/.venv-sim/

# OpenMC source + build tree (rebuilt by scripts/install_openmc.sh)
/external/
.claude/

